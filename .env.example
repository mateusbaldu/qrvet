SPRING_PROFILE=prod
TZ=America/Sao_Paulo

#Credenciais do banco de dados
DB_NAME=qrvet
DB_USER=qrvet
DB_PASSWORD=sua_senha_forte
DB_ROOT_PASSWORD=sua_senha_root

FRONTEND_URL=http://localhost:3000
# QRVET_FRONTEND_URL tem prioridade sobre FRONTEND_URL.
# QRVET_PUBLIC_URL pode sobrescrever a origem dos links do QR Code e do tutor.
COOKIE_SECURE=false
JWT_SECRET=gere-um-segredo-base64-com-32-bytes

#Credenciais de admin default para bootstrap do sistema
BOOTSTRAP_SECRET=seu-segredo-de-bootstrap
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_NAME=Administrador QRVet
BOOTSTRAP_ADMIN_EMAIL=admin@qrvet.local
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha

# Opcional: sobrescreve o SMTP de demonstracao ja incluido no Docker Compose.
# Para outra conta Gmail, use uma senha de app do Google.
# O remetente deve ser a conta autenticada ou um alias autorizado pelo provedor.
# Para capturar e-mails de teste no Mailpit, use docker-compose.dev.yml.
MAIL_FROM=seu-email@gmail.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua_senha_de_app
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_SSL=false
