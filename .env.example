SPRING_PROFILE=prod
TZ=America/Sao_Paulo

#Credenciais do banco de dados
DB_NAME=qrvet
DB_USER=qrvet
DB_PASSWORD=sua_senha_forte
DB_ROOT_PASSWORD=sua_senha_root

FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
JWT_SECRET=gere-um-segredo-base64-com-32-bytes

#Credenciais de admin default para bootstrap do sistema
BOOTSTRAP_SECRET=seu-segredo-de-bootstrap
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_NAME=Administrador QRVet
BOOTSTRAP_ADMIN_EMAIL=admin@qrvet.local
BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha

#Credenciais de provedor de email para envio de notificações
MAIL_FROM=no-reply@qrvet.local
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=seu_username
MAIL_PASSWORD=sua_senha_segura
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_SSL=false
